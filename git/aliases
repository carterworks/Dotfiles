[alias]
  branches = branch -a
  branch-name = rev-parse --abbrev-ref HEAD
  c = commit
  cleanup = "!git branch -vv | grep ': gone]' | awk '{print $1}' | fzf --multi --sync --bind start:select-all | xargs git branch -D; git remote prune origin;"
  co = checkout
  ll = log --graph --topo-order --abbrev-commit --date=short --decorate --all --boundary --pretty=format:'%Cgreen%ad %Cred%h%Creset -%C(yellow)%d%Creset %s %Cblue[%cn]%Creset %Cblue%G?%Creset'
  pruner = "!git prune --expire=now; git reflog expire --expire-unreachable=now --rewrite --all"
  publish = "!git push --set-upstream origin $(git branch-name)"
  s = status
  ss = status --short
  sw = switch
  swb = "!f() { branch=$(git branch --format='%(refname:short)' --sort=-committerdate | fzf --height=40% --layout=reverse --border --preview='git log --graph --color=always --decorate --oneline --date=relative --pretty=format:\"%C(auto)%h %Cgreen%cr %Creset%s %Cblue[%an]%Creset%C(auto)%d\" -- {}' --preview-window=right:60%); [ -n \"$branch\" ] && git switch \"$branch\"; }; f"
  undo-commit = reset --soft HEAD~1
  unpublish = "!git push origin :$(git branch-name)"
