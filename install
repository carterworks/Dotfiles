#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NIX_ACCESS_TOKEN_ARGS=()

# A run detached into its own session has no controlling terminal, so the
# caller names the terminal that should receive OSC 7501 reports.
STATUS_TTY="${DOTFILES_STATUS_TTY:-/dev/tty}"

if command -v gh >/dev/null 2>&1; then
  github_token="$(gh auth token 2>/dev/null || true)"
  if [[ -n "${github_token}" ]]; then
    NIX_ACCESS_TOKEN_ARGS=(--option access-tokens "github.com=${github_token}")
  fi
fi

has_gum() {
  command -v gum >/dev/null 2>&1
}

log_message() {
  local level="$1"
  shift

  if has_gum; then
    gum log --level "${level}" "$*"
  else
    case "${level}" in
      error|warn)
        printf '%s\n' "$*" >&2
        ;;
      *)
        printf '%s\n' "$*"
        ;;
    esac
  fi
}

section() {
  local title="$1"

  if has_gum; then
    gum style --bold --foreground 255 --background 62 --padding "0 1" --margin "1 0" "${title}"
  else
    printf '\n== %s ==\n' "${title}"
  fi
}

show_log() {
  local logfile="$1"

  if [[ -s "${logfile}" ]]; then
    printf '\n' >&2
    cat "${logfile}" >&2
  fi
}

# Report state to the terminal with OSC 7501:
# https://www.superlogical.com/rex/docs/build/program-status
program_status() {
  local state="$1"
  local message="$2"
  shift 2
  local pairs=("state=${state}" app=dotfiles "$@" "msg=$(printf '%s' "${message}" | base64 | tr -d '\n')")
  local IFS=:

  { printf '\e]7501;%s\e\\' "${pairs[*]}" >"${STATUS_TTY}"; } 2>/dev/null || true
}

report_exit_status() {
  local status=$?

  case "${status}" in
    0) program_status "done" "Dotfiles install complete" ;;
    130) program_status idle "Dotfiles install cancelled" ;;
    *) program_status error "Dotfiles install failed" ;;
  esac
}

# Print the build percentage whenever it changes, from Nix's internal-json log.
# Activity type 104 counts builds and 103 counts substitutions; result type 105
# carries [done, expected, running, failed].
nix_progress() {
  jq -Rnr --unbuffered '
    foreach (inputs | fromjson?) as $event ({ progress: {}, percent: null };
      ($event.id | tostring) as $id
      | if $event.action == "start" and ($event.type == 103 or $event.type == 104) then
          .progress[$id] = [0, 0]
        elif $event.action == "result" and $event.type == 105 and .progress[$id] then
          .progress[$id] = $event.fields
        else . end
      | .previous = .percent
      | ([.progress[][1]] | add // 0) as $expected
      | .percent = if $expected > 0 then ([.progress[][0]] | add) * 100 / $expected | floor else null end;
      select(.percent != null and .percent != .previous) | .percent)
  '
}

# Run a Nix command, or a wrapper such as darwin-rebuild that forwards --option
# to Nix, and report its build progress. Nix tees its JSON log to the FIFO while
# its own progress output stays on the terminal.
run_with_nix_progress() {
  local message="$1"
  shift

  local fifo_dir
  local reader
  local status=0

  program_status working "${message}"
  if ! command -v jq >/dev/null 2>&1; then
    "$@"
    return
  fi

  fifo_dir="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-install.XXXXXX")"
  mkfifo "${fifo_dir}/nix-log"
  nix_progress <"${fifo_dir}/nix-log" | while read -r percent; do
    program_status working "${message}" "progress=${percent}"
  done &
  reader=$!
  # Hold a writer open so the reader survives between the several Nix processes
  # a rebuild runs, and a later Nix never blocks opening a FIFO with no reader.
  exec 3<>"${fifo_dir}/nix-log"
  "$@" --option json-log-path "${fifo_dir}/nix-log" || status=$?
  exec 3>&-
  wait "${reader}"
  rm -rf "${fifo_dir}"
  return "${status}"
}

authenticate_sudo() {
  if sudo -n true 2>/dev/null; then
    return
  fi
  program_status blocked "Password required to switch the system" kind=auth
  sudo -v
}

run_quiet_step() {
  local title="$1"
  shift

  local logfile
  local pid
  local status=0

  program_status working "${title}"
  logfile="$(mktemp "${TMPDIR:-/tmp}/dotfiles-install.XXXXXX")"
  "$@" >"${logfile}" 2>&1 &
  pid=$!

  if has_gum; then
    gum spin --spinner dot --title "${title}" -- bash -c 'pid="$1"; while kill -0 "$pid" 2>/dev/null; do sleep 0.1; done' _ "${pid}"
  else
    log_message info "${title}"
  fi

  if wait "${pid}"; then
    status=0
  else
    status=$?
  fi

  if (( status == 0 )); then
    rm -f "${logfile}"
    log_message info "${title} complete"
    return 0
  fi

  log_message error "${title} failed"
  show_log "${logfile}"
  rm -f "${logfile}"
  return "${status}"
}

warn_if_git_dirty() {
  if command -v git >/dev/null 2>&1 && [[ -n "$(git -C "${BASEDIR}" status --short 2>/dev/null)" ]]; then
    log_message warn "Git tree is dirty; Nix may warn during evaluation"
  fi
}

if ! command -v nix >/dev/null 2>&1; then
  log_message error "nix is required to run this installer"
  log_message info "Install it from: https://github.com/DeterminateSystems/nix-installer"
  exit 1
fi

current_machine_name() {
  local name

  case "$(uname -s)" in
    Darwin)
      if command -v scutil >/dev/null 2>&1; then
        name="$(scutil --get LocalHostName 2>/dev/null || true)"
      fi
      ;;
    Linux)
      if command -v hostnamectl >/dev/null 2>&1; then
        name="$(hostnamectl --static 2>/dev/null || true)"
      fi
      if [[ -z "${name:-}" && -r /etc/hostname ]]; then
        IFS= read -r name < /etc/hostname
      fi
      ;;
  esac

  if [[ -z "${name:-}" ]]; then
    name="$(hostname)"
    name="${name%%.*}"
  fi

  if [[ -z "${name}" ]]; then
    printf 'Could not determine machine name.\n' >&2
    exit 1
  fi

  printf '%s\n' "${name}"
}

follow_rebuild_log() {
  local line
  local pending=""
  local complete=false

  while true; do
    if IFS= read -r line; then
      printf '%s\n' "${pending}${line}"
      pending=""
    else
      pending+="${line}"
      if "${complete}"; then
        [[ -z "${pending}" ]] || printf '%s\n' "${pending}"
        break
      elif [[ -f "$2" ]]; then
        complete=true
      else
        sleep 0.1
      fi
    fi
  done <"$1"
}

# Home Manager restarts T3 and OpenCode during activation, and they signal the
# installer they host before it can load them again. Detach activation so it
# always finishes; the installer only follows its log. It must stay in this
# login session: nix-darwin needs the GUI session and the terminal's App
# Management permission to update /Applications, so launchd will not do.
# macOS has no setsid(1), so job control (set -m) gives activation its own
# process group and the root shell exits to orphan it. Signals to the installer
# or its group, the SIGHUP a closing terminal sends its foreground group, and
# killers that walk the installer's process tree all miss it; HUP, INT and TERM
# are ignored besides. Only killing the whole session would still reach it.
# Bash, not sh: busybox sh refuses set -m without a terminal, and dash takes
# the terminal's foreground group away from the installer.
run_darwin_activation() {
  local system_path="$1"
  local state_dir

  mkdir -p "${HOME}/Library/Logs/dotfiles-install"
  state_dir="$(mktemp -d "${HOME}/Library/Logs/dotfiles-install/activate.XXXXXX")"
  program_status working "Activating system"
  log_message info "Activation log: ${state_dir}/activate.log"
  touch "${state_dir}/activate.log"

  sudo -H "${BASH}" -c '
    exec </dev/null >>"$1/activate.log" 2>&1
    trap "" HUP INT TERM
    set -m
    (
      NIX_REMOTE=daemon "$3" -p /nix/var/nix/profiles/system --set "$2" && "$2/sw/bin/darwin-rebuild" activate
      printf "%s\n" "$?" > "$1/status.new"
      mv "$1/status.new" "$1/status"
    ) &
  ' dotfiles-activate "${state_dir}" "${system_path}" "$(command -v nix-env)" || return $?

  follow_rebuild_log "${state_dir}/activate.log" "${state_dir}/status"
  return "$(<"${state_dir}/status")"
}

run_rebuild() {
  local rebuild
  local machine_name
  local system_path

  machine_name="$(current_machine_name)"

  case "$(uname -s)" in
    Darwin)
      # Build as the invoking user: root cannot read a user-owned Git checkout.
      system_path="$(run_with_nix_progress "Building system" nix "${NIX_ACCESS_TOKEN_ARGS[@]}" build --print-out-paths --no-link "${BASEDIR}#darwinConfigurations.\"${machine_name}\".system")"
      authenticate_sudo
      run_darwin_activation "${system_path}"
      ;;
    Linux)
      if [[ ! -e /etc/NIXOS && ! -e /run/current-system/nixos-version ]]; then
        printf 'Unsupported Linux system; expected NixOS.\n' >&2
        exit 1
      fi

      rebuild="$(command -v nixos-rebuild || true)"
      if [[ -z "${rebuild}" ]]; then
        printf 'nixos-rebuild is required on NixOS systems.\n' >&2
        exit 1
      fi

      authenticate_sudo
      run_with_nix_progress "Rebuilding system" sudo "${rebuild}" switch --flake "${BASEDIR}#${machine_name}" "${NIX_ACCESS_TOKEN_ARGS[@]}"
      ;;
    *)
      printf 'Unsupported system: %s\n' "$(uname -s)" >&2
      exit 1
      ;;
  esac
}

cd "${BASEDIR}"
trap report_exit_status EXIT
section "Dotfiles install"
log_message info "Machine: $(current_machine_name)"
log_message info "System: $(uname -s)"
warn_if_git_dirty

section "Rebuild system"
log_message info "Starting system rebuild"
run_rebuild
log_message info "System rebuild complete"
