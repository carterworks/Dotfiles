#compdef agent-browser
# From agent-browser --help.
local -a commands=(
  'skills:list, print or locate bundled skills'
  'open:navigate to a URL'
  'read:fetch agent-readable text'
  'click:click an element'
  'dblclick:double-click an element'
  'type:type into an element'
  'fill:clear and fill an element'
  'press:press a key'
  'keyboard:type or insert text without a selector'
  'hover:hover an element'
  'focus:focus an element'
  'check:check a checkbox'
  'uncheck:uncheck a checkbox'
  'select:select dropdown options'
  'drag:drag and drop'
  'upload:upload files'
  'download:download a file by clicking an element'
  'scroll:scroll the page'
  'scrollintoview:scroll an element into view'
  'wait:wait for an element or time'
  'screenshot:take a screenshot'
  'pdf:save as PDF'
  'snapshot:accessibility tree with refs'
  'eval:run JavaScript'
  'connect:connect to a browser over CDP'
  'close:close the browser'
  'back:go back'
  'forward:go forward'
  'reload:reload the page'
  'get:get page or element information'
  'is:check element state'
  'find:find elements by locator'
  'mouse:move, press, release or scroll the mouse'
  'set:change browser settings'
  'network:route, inspect or record requests'
  'cookies:manage cookies'
  'storage:manage web storage'
  'tab:manage tabs'
  'diff:compare snapshots, screenshots or pages'
  'trace:record a DevTools trace'
  'profiler:record a DevTools profile'
  'record:record video'
  'console:view console logs'
  'errors:view page errors'
  'highlight:highlight an element'
  'inspect:open DevTools for the page'
  'clipboard:read or write the clipboard'
  'stream:runtime WebSocket streaming'
  'webmcp:page tools over WebMCP'
  'flow:saved flows'
  'react:inspect React components'
  'vitals:Core Web Vitals'
  'a11y:accessibility audit'
  'pushstate:client-side navigation'
  'removeinitscript:remove a registered init script'
  'batch:run several commands'
  'auth:saved credentials'
  'plugin:plugins'
  'confirm:approve a pending action'
  'deny:deny a pending action'
  'session:show or list sessions'
  'mcp:start an MCP stdio server'
  'chat:natural language instructions'
  'dashboard:observability dashboard'
  'install:install browser binaries'
  'upgrade:upgrade agent-browser'
  'doctor:diagnose the install'
  'profiles:list Chrome profiles'
)
typeset -A actions=(
  skills 'list get path'
  keyboard 'type inserttext'
  get 'text html value attr title url count box styles cdp-url'
  is 'visible enabled checked'
  find 'role text label placeholder alt title testid first last nth'
  mouse 'move down up wheel'
  set 'viewport device geo offline headers credentials media'
  network 'route unroute requests har'
  cookies 'get set clear'
  storage 'local session'
  tab 'new list close'
  diff 'snapshot screenshot url'
  trace 'start stop'
  profiler 'start stop'
  record 'start stop'
  clipboard 'read write copy paste'
  stream 'enable disable status'
  webmcp 'list invoke result cancel'
  flow 'steps save run list'
  react 'tree inspect renders suspense'
  auth 'save login list show delete'
  plugin 'add list show run'
  session 'list'
  dashboard 'start stop'
)
local -a global=(
  '--session[isolated session name]:name'
  '--namespace[isolate daemon sockets and restore state]:name'
  '--profile[Chrome profile name or directory]:profile:_files -/'
  '--restore=-[auto-save and restore cookies and storage]::name'
  '--restore-save[restore auto-save policy]:policy:(auto always never)'
  '--state[load saved auth state]:state file:_files'
  '--auto-connect[connect to a running Chrome]'
  '--no-auto-connect[launch locally instead of auto-connecting]'
  '--headers[HTTP headers for the URL origin]:JSON'
  '--executable-path[browser executable]:executable:_files'
  '*--extension[load a browser extension]:extension:_files -/'
  '*--init-script[register a page init script]:script:_files'
  '*--enable[built-in init scripts]:feature:(react-devtools)'
  '--args[browser launch arguments]:arguments'
  '--user-agent[User-Agent]:user agent'
  '--proxy[proxy server URL]:URL'
  '--proxy-bypass[hosts that bypass the proxy]:hosts'
  '--ignore-https-errors[ignore HTTPS certificate errors]'
  '--ca-cert[trust a CA certificate]:certificate:_files'
  '--no-ca-cert[clear retained CA trust]'
  '--use-system-ca[use the OS trust store]'
  '--allow-file-access[allow file URLs to read local files]'
  '--hide-scrollbars[hide scrollbars in screenshots]:hide:(true false)'
  '(-p --provider)'{-p,--provider}'[browser provider]:provider:(ios browserbase kernel browseruse browserless agentcore)'
  '--device[iOS device name]:device'
  '--json[JSON output]'
  '--annotate[annotated screenshots]'
  '--screenshot-dir[screenshot directory]:directory:_files -/'
  '--screenshot-quality[JPEG quality]:quality (0-100)'
  '--screenshot-format[screenshot format]:format:(png jpeg)'
  '--input-mode[pointer movement]:mode:(instant smooth human)'
  '--headed[show the browser window]'
  '--webgpu[enable WebGPU]'
  '--no-webmcp[disable WebMCP]'
  '--cdp[connect over CDP]:port or URL'
  '--cdp-headers[headers for CDP discovery]:JSON'
  '(--no-pin-tab)--pin-tab[pin the session to its tab]'
  '(--pin-tab)--no-pin-tab[unpin the session]'
  '--color-scheme[color scheme]:scheme:(dark light no-preference)'
  '--download-path[download directory]:directory:_files -/'
  '--content-boundaries[wrap page output in boundary markers]'
  '--max-output[truncate page output]:characters'
  '--allowed-domains[restrict network domains]:domains'
  '--capture[record the session]:capture:(flow)'
  '--action-policy[action policy file]:policy file:_files'
  '--confirm-actions[categories that need confirmation]:categories'
  '--confirm-interactive[prompt for confirmations]'
  '--idle-timeout[shut down after inactivity]:time'
  '--engine[browser engine]:engine:(chrome lightpanda obscura)'
  '--no-auto-dialog[keep dialogs open]'
  '--relaunch[relaunch the browser]'
  '--model[AI model for chat]:model'
  '(-v --verbose -q --quiet)'{-v,--verbose}'[show tool commands and output]'
  '(-v --verbose -q --quiet)'{-q,--quiet}'[show only AI responses]'
  '--config[config file]:config file:_files'
  '--debug[debug output]'
  '(- *)'{-h,--help}'[show help]'
)
local curcontext=$curcontext state line
_arguments -C $global '1: :->command' '*:: :->args'
case $state in
  command) _describe -t commands 'agent-browser command' commands ;;
  args)
    local cmd=$words[1]
    if (( CURRENT == 2 )) && [[ -n ${actions[$cmd]-} ]]; then
      _wanted actions expl "$cmd action" compadd -- ${=actions[$cmd]}
    else
      case $cmd in
        snapshot)
          _arguments $global \
            '(-i --interactive)'{-i,--interactive}'[only interactive elements]' \
            '(-c --compact)'{-c,--compact}'[remove empty structural elements]' \
            '(-d --depth)'{-d,--depth}'[limit tree depth]:depth' \
            '(-s --selector)'{-s,--selector}'[scope to a CSS selector]:selector' ;;
        screenshot|pdf|upload|download|record) _files ;;
        *) _arguments $global '*: :_default' ;;
      esac
    fi ;;
esac
