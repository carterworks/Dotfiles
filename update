#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NIX_ACCESS_TOKEN_ARGS=()

if command -v gh >/dev/null 2>&1; then
  github_token="$(gh auth token 2>/dev/null || true)"
  if [[ -n "${github_token}" ]]; then
    NIX_ACCESS_TOKEN_ARGS=(--option access-tokens "github.com=${github_token}")
  fi
fi

APPLY=false

has_gum() {
  command -v gum >/dev/null 2>&1
}

log_message() {
  local level="$1"
  shift

  if has_gum; then
    gum log --level "${level}" "$*"
  else
    case "${level}" in
      error|warn)
        printf '%s\n' "$*" >&2
        ;;
      *)
        printf '%s\n' "$*"
        ;;
    esac
  fi
}

section() {
  local title="$1"

  if has_gum; then
    gum style --bold --foreground 255 --background 62 --padding "0 1" --margin "1 0" "${title}"
  else
    printf '\n== %s ==\n' "${title}"
  fi
}

show_log() {
  local logfile="$1"

  if [[ -s "${logfile}" ]]; then
    printf '\n' >&2
    cat "${logfile}" >&2
  fi
}

run_quiet_step() {
  local title="$1"
  shift

  local logfile
  local pid
  local status=0

  logfile="$(mktemp "${TMPDIR:-/tmp}/dotfiles-update.XXXXXX")"
  "$@" >"${logfile}" 2>&1 &
  pid=$!

  if has_gum; then
    gum spin --spinner dot --title "${title}" -- bash -c 'pid="$1"; while kill -0 "$pid" 2>/dev/null; do sleep 0.1; done' _ "${pid}"
  else
    log_message info "${title}"
  fi

  if wait "${pid}"; then
    status=0
  else
    status=$?
  fi

  if (( status == 0 )); then
    rm -f "${logfile}"
    log_message info "${title} complete"
    return 0
  fi

  log_message error "${title} failed"
  show_log "${logfile}"
  rm -f "${logfile}"
  return "${status}"
}

warn_if_git_dirty() {
  if command -v git >/dev/null 2>&1 && [[ -n "$(git -C "${BASEDIR}" status --short 2>/dev/null)" ]]; then
    log_message warn "Git tree is dirty; Nix may warn during evaluation"
  fi
}

confirm_apply() {
  local count="$1"

  if [[ "${APPLY}" == true ]]; then
    return 0
  fi

  if has_gum && [[ -t 0 ]]; then
    if gum confirm "Apply ${count} package update(s)?"; then
      return 0
    fi
    return 1
  fi

  log_message info "Re-run with --apply to bump versions and hashes"
  return 1
}

require_tool() {
  local tool="$1"

  if ! command -v "${tool}" >/dev/null 2>&1; then
    log_message error "${tool} is required to run this updater"
    exit 1
  fi
}

github_api() {
  local endpoint="$1"

  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    gh api "${endpoint}"
  else
    curl -fsSL "https://api.github.com/${endpoint}"
  fi
}

latest_update() {
  local update_info="$1"
  local source

  source="$(jq -r '.source' <<<"${update_info}")"
  case "${source}" in
    github-release)
      local owner repo prefix tag version
      owner="$(jq -r '.owner' <<<"${update_info}")"
      repo="$(jq -r '.repo' <<<"${update_info}")"
      prefix="$(jq -r '.tagPrefix // ""' <<<"${update_info}")"
      tag="$(github_api "repos/${owner}/${repo}/releases/latest" | jq -r '.tag_name')"
      version="${tag#"${prefix}"}"
      jq -cn --arg revision "${version}" --arg version "${version}" '{ revision: $revision, version: $version }'
      ;;
    npm)
      local package channel version
      package="$(jq -r '.package' <<<"${update_info}")"
      channel="$(jq -r '.channel // "latest"' <<<"${update_info}")"
      version="$(curl -fsSL "https://registry.npmjs.org/${package}" | jq -r --arg channel "${channel}" '.["dist-tags"][$channel]')"
      jq -cn --arg revision "${version}" --arg version "${version}" '{ revision: $revision, version: $version }'
      ;;
    github-branch)
      local owner repo branch commit
      owner="$(jq -r '.owner' <<<"${update_info}")"
      repo="$(jq -r '.repo' <<<"${update_info}")"
      branch="$(jq -r '.branch' <<<"${update_info}")"
      commit="$(github_api "repos/${owner}/${repo}/commits/${branch}")"
      jq -cn \
        --arg revision "$(jq -r '.sha' <<<"${commit}")" \
        --arg version "0-unstable-$(jq -r '.commit.committer.date | split("T")[0]' <<<"${commit}")" \
        '{ revision: $revision, version: $version }'
      ;;
    *)
      return 1
      ;;
  esac
}

release_asset_url() {
  local update_info="$1"
  local version="$2"
  local owner repo prefix pattern

  owner="$(jq -r '.owner' <<<"${update_info}")"
  repo="$(jq -r '.repo' <<<"${update_info}")"
  prefix="$(jq -r '.tagPrefix // ""' <<<"${update_info}")"
  pattern="$(jq -r '.assetPattern' <<<"${update_info}")"
  github_api "repos/${owner}/${repo}/releases/tags/${prefix}${version}" \
    | jq -er --arg pattern "${pattern}" \
      '[.assets[] | select(.name | test($pattern)) | .browser_download_url]
      | if length == 1 then .[0] else error("expected exactly one matching release asset") end'
}

package_systems() {
  local pkg="$1"
  local system

  for system in "${SYSTEMS[@]}"; do
    if nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.pname" >/dev/null 2>&1; then
      printf '%s\n' "${system}"
    fi
  done
}

# Rewrite version and every per-platform hash in a package expression. URLs and
# current hashes come from the flake itself, so no URL scheme is duplicated here.
apply_update() {
  local pkg="$1"
  local file="$2"
  local current="$3"
  local latest="$4"
  local update_info="$5"

  local system oldurl oldhash newurl newhash content i old_asset new_asset
  local -a pkg_systems=()
  local -a old_hashes=()
  local -a new_hashes=()

  mapfile -t pkg_systems < <(package_systems "${pkg}")
  if (( ${#pkg_systems[@]} == 0 )); then
    return 1
  fi

  if jq -e '.assetPattern' <<<"${update_info}" >/dev/null; then
    newurl="$(release_asset_url "${update_info}" "${latest}")" || return 1
  fi

  for system in "${pkg_systems[@]}"; do
    oldurl="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.src.url")"
    oldhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.src.outputHash")"
    if ! jq -e '.assetPattern' <<<"${update_info}" >/dev/null; then
      newurl="${oldurl//${current}/${latest}}"
    fi
    newhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" store prefetch-file --json "${newurl}" | jq -r '.hash')" || return 1
    old_hashes+=("${oldhash}")
    new_hashes+=("${newhash}")
  done

  content="$(cat "${file}")"
  for i in "${!old_hashes[@]}"; do
    content="${content//${old_hashes[$i]}/${new_hashes[$i]}}"
  done
  if jq -e '.assetPattern' <<<"${update_info}" >/dev/null; then
    old_asset="${oldurl##*/}"
    new_asset="${newurl##*/}"
    content="${content//${old_asset}/${new_asset}}"
  fi
  content="${content//version = \"${current}\"/version = \"${latest}\"}"
  printf '%s\n' "${content}" >"${file}"
}

nixpkgs_tool() {
  local tool="$1"
  local flake_ref expression

  flake_ref="$(jq -Rn --arg value "path:${BASEDIR}" '$value')"
  expression="let flake = builtins.getFlake ${flake_ref}; in flake.inputs.nixpkgs.legacyPackages.${CURRENT_SYSTEM}.${tool}"
  nix "${NIX_ACCESS_TOKEN_ARGS[@]}" build --impure --no-link --print-out-paths --expr "${expression}"
}

apply_npm_lock_update() {
  local pkg="$1"
  local file="$2"
  local current="$3"
  local latest="$4"
  local system="$5"
  local update_info="$6"
  local oldurl oldhash old_deps_hash newurl newhash npm_package npm_path prefetch_path new_deps_hash content tempdir

  oldurl="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.updateSource.url")"
  oldhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.updateSource.outputHash")"
  old_deps_hash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.npmDeps.outputHash")"
  newurl="${oldurl//${current}/${latest}}"
  newhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" store prefetch-file --json "${newurl}" | jq -r '.hash')" || return 1
  npm_package="$(jq -r '.package' <<<"${update_info}")"

  tempdir="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-npm-update.XXXXXX")"
  if ! curl -fsSL "https://registry.npmjs.org/${npm_package}/${latest}" \
    | jq '{ name, version, main, bin, engines, dependencies }' >"${tempdir}/package.json"; then
    rm -rf "${tempdir}"
    return 1
  fi

  npm_path="$(nixpkgs_tool nodejs)" || {
    rm -rf "${tempdir}"
    return 1
  }
  if ! (cd "${tempdir}" && "${npm_path}/bin/npm" install --package-lock-only --ignore-scripts --no-audit --no-fund >/dev/null); then
    rm -rf "${tempdir}"
    return 1
  fi

  prefetch_path="$(nixpkgs_tool prefetch-npm-deps)" || {
    rm -rf "${tempdir}"
    return 1
  }
  new_deps_hash="$("${prefetch_path}/bin/prefetch-npm-deps" "${tempdir}/package-lock.json")" || {
    rm -rf "${tempdir}"
    return 1
  }

  content="$(cat "${file}")"
  content="${content//${oldhash}/${newhash}}"
  content="${content//${old_deps_hash}/${new_deps_hash}}"
  content="${content//version = \"${current}\"/version = \"${latest}\"}"
  printf '%s\n' "${content}" >"${file}"
  mv "${tempdir}/package.json" "${BASEDIR}/nix/packages/${pkg}/package.json"
  mv "${tempdir}/package-lock.json" "${BASEDIR}/nix/packages/${pkg}/package-lock.json"
  rm -rf "${tempdir}"
}

apply_pnpm_git_update() {
  local pkg="$1"
  local file="$2"
  local current_revision="$3"
  local latest_revision="$4"
  local current_version="$5"
  local latest_version="$6"
  local system="$7"
  local update_info="$8"
  local owner repo oldhash old_deps_hash newhash content backup logfile new_deps_hash
  local fake_hash="sha256-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

  owner="$(jq -r '.owner' <<<"${update_info}")"
  repo="$(jq -r '.repo' <<<"${update_info}")"
  oldhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.src.outputHash")"
  old_deps_hash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.pnpmDeps.outputHash")"
  newhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" store prefetch-file --unpack --json \
    "https://github.com/${owner}/${repo}/archive/${latest_revision}.tar.gz" | jq -r '.hash')" || return 1

  backup="$(mktemp "${file}.XXXXXX")"
  logfile="$(mktemp "${TMPDIR:-/tmp}/dotfiles-pnpm-update.XXXXXX")"
  cp "${file}" "${backup}"
  content="$(cat "${file}")"
  content="${content//${current_revision}/${latest_revision}}"
  content="${content//${oldhash}/${newhash}}"
  content="${content//${old_deps_hash}/${fake_hash}}"
  content="${content//version = \"${current_version}\"/version = \"${latest_version}\"}"
  printf '%s\n' "${content}" >"${file}"

  if nix "${NIX_ACCESS_TOKEN_ARGS[@]}" build --no-link ".#packages.${system}.${pkg}" >"${logfile}" 2>&1; then
    cp "${backup}" "${file}"
    rm -f "${backup}" "${logfile}"
    return 1
  fi
  new_deps_hash="$(sed -n 's/^[[:space:]]*got:[[:space:]]*//p' "${logfile}" | tail -n1)"
  if [[ "${new_deps_hash}" != sha256-* ]]; then
    show_log "${logfile}"
    cp "${backup}" "${file}"
    rm -f "${backup}" "${logfile}"
    return 1
  fi

  content="$(cat "${file}")"
  content="${content//${fake_hash}/${new_deps_hash}}"
  printf '%s\n' "${content}" >"${file}"
  if ! nix "${NIX_ACCESS_TOKEN_ARGS[@]}" build --no-link ".#packages.${system}.${pkg}" >"${logfile}" 2>&1; then
    show_log "${logfile}"
    cp "${backup}" "${file}"
    rm -f "${backup}" "${logfile}"
    return 1
  fi
  rm -f "${backup}" "${logfile}"
}

regenerate_skill() {
  local package="$1"
  local name="$2"
  local generated
  local generated_source
  local skill="${BASEDIR}/agents/skills/generated/${name}/SKILL.md"

  generated="$(mktemp "${skill}.XXXXXX")"
  if generated_source="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" build --no-link --print-out-paths ".#${package}")" \
    && cp "${generated_source}" "${generated}"; then
    mv "${generated}" "${skill}"
  else
    rm -f "${generated}"
    return 1
  fi
}

usage() {
  cat <<EOF
Update flake inputs and manually packaged binaries.

Usage: ./update [--apply]

  --apply   Bump version and hashes for any out-of-date package.
  -h, --help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)
      APPLY=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log_message error "Unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

require_tool nix
require_tool curl
require_tool jq
CURRENT_SYSTEM="$(nix eval --impure --raw --expr builtins.currentSystem)"

cd "${BASEDIR}"
section "Dotfiles update"
warn_if_git_dirty

if [[ "${APPLY}" == true ]]; then
  section "Update flake inputs"
  run_quiet_step "Updating flake inputs" nix "${NIX_ACCESS_TOKEN_ARGS[@]}" flake update

  section "Update generated files"
  run_quiet_step "Updating Browser skill" regenerate_skill agent-browser-skill agent-browser
  run_quiet_step "Updating Herdr skill" regenerate_skill herdr-skill herdr
  run_quiet_step "Updating Hunk skill" regenerate_skill hunk-skill hunk-review
fi

section "Check packaged binaries"

mapfile -t SYSTEMS < <(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --json ".#packages" --apply builtins.attrNames | jq -r '.[]')

updates=()
for file in "${BASEDIR}"/nix/packages/*.nix; do
  pkg="$(sed -n 's/.*pname = "\([^"]*\)".*/\1/p' "${file}" | head -n1)"
  [[ -n "${pkg}" ]] || continue

  mapfile -t supported_systems < <(package_systems "${pkg}")
  package_system="${supported_systems[0]:-}"
  if [[ -z "${package_system}" ]]; then
    log_message warn "${pkg}: not exposed through flake packages; skipping"
    continue
  fi

  current_version="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${package_system}.${pkg}.version" 2>/dev/null || true)"
  if [[ -z "${current_version}" ]]; then
    log_message warn "${pkg}: no version attribute; skipping"
    continue
  fi

  update_info="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --json ".#packages.${package_system}.${pkg}.updateInfo" 2>/dev/null || true)"
  if [[ -z "${update_info}" || "${update_info}" == null ]]; then
    log_message warn "${pkg}: no update metadata; skipping"
    continue
  fi

  source="$(jq -r '.source' <<<"${update_info}")"
  if [[ "${source}" == github-branch ]]; then
    current_revision="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${package_system}.${pkg}.src.rev" 2>/dev/null || true)"
  else
    current_revision="${current_version}"
  fi
  latest_update_info="$(latest_update "${update_info}" 2>/dev/null || true)"
  latest_revision="$(jq -r '.revision // empty' <<<"${latest_update_info}" 2>/dev/null || true)"
  latest_version="$(jq -r '.version // empty' <<<"${latest_update_info}" 2>/dev/null || true)"
  if [[ -z "${latest_revision}" || -z "${latest_version}" ]]; then
    log_message warn "${pkg}: failed to discover latest upstream version; skipping"
    continue
  fi

  if [[ "${current_revision}" == "${latest_revision}" ]]; then
    log_message info "${pkg}: up to date (${current_version})"
  else
    log_message warn "${pkg}: update available (${current_version} -> ${latest_version})"
    encoded_update_info="$(printf '%s' "${update_info}" | base64)"
    updates+=("${pkg}|${file}|${current_revision}|${latest_revision}|${current_version}|${latest_version}|${package_system}|${encoded_update_info}")
  fi
done

if (( ${#updates[@]} == 0 )); then
  log_message info "All packaged binaries up to date"
  exit 0
fi

if ! confirm_apply "${#updates[@]}"; then
  exit 0
fi

section "Apply updates"
for entry in "${updates[@]}"; do
  IFS='|' read -r pkg file current_revision latest_revision current_version latest_version package_system encoded_update_info <<<"${entry}"
  update_info="$(printf '%s' "${encoded_update_info}" | base64 --decode)"
  strategy="$(jq -r '.strategy // "archive"' <<<"${update_info}")"
  case "${strategy}" in
    archive)
      update_command=(apply_update "${pkg}" "${file}" "${current_version}" "${latest_version}" "${update_info}")
      ;;
    npm-lock)
      update_command=(apply_npm_lock_update "${pkg}" "${file}" "${current_version}" "${latest_version}" "${package_system}" "${update_info}")
      ;;
    pnpm-git)
      update_command=(apply_pnpm_git_update "${pkg}" "${file}" "${current_revision}" "${latest_revision}" "${current_version}" "${latest_version}" "${package_system}" "${update_info}")
      ;;
    *)
      log_message error "${pkg}: unknown update strategy ${strategy}"
      continue
      ;;
  esac
  if ! run_quiet_step "Bumping ${pkg} to ${latest_version}" "${update_command[@]}"; then
    log_message error "${pkg}: failed to bump; left unchanged"
  fi
done

log_message info "Run ./check to validate, then ./install to switch"
