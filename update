#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# A run detached into its own session has no controlling terminal, so the
# caller names the terminal that should receive OSC 7501 reports.
STATUS_TTY="${DOTFILES_STATUS_TTY:-/dev/tty}"

APPLY=false
MAJORS=false
GITHUB_TOKEN_VALUE=""
SKILLS=(agent-browser-skill:agent-browser herdr-skill:herdr hunk-skill:hunk-review)
CHANGES=()
NOTES=()
FAILURES=()
SKOPEO=""

# Progress goes to stderr so stdout carries only the summary.
log() {
  printf '%s\n' "$*" >&2
}

changed() {
  CHANGES+=("$1")
}

note() {
  NOTES+=("$1")
  log "$1"
}

failed() {
  FAILURES+=("$1")
  log "$1: $2"
}

# Report state to the terminal with OSC 7501:
# https://www.superlogical.com/rex/docs/build/program-status
program_status() {
  local state="$1"
  local message="$2"
  shift 2
  local pairs=("state=${state}" app=dotfiles "$@" "msg=$(printf '%s' "${message}" | base64 | tr -d '\n')")
  local IFS=:

  { printf '\e]7501;%s\e\\' "${pairs[*]}" >"${STATUS_TTY}"; } 2>/dev/null || true
}

report_exit_status() {
  local status=$?

  case "${status}" in
    0) program_status "done" "Dotfiles update complete" ;;
    130) program_status idle "Dotfiles update cancelled" ;;
    *) program_status error "Dotfiles update failed" ;;
  esac
}

# Nix repeats its flake-config warnings on every call; show a command's stderr
# only when it fails.
quiet() {
  local err
  local status=0

  err="$(mktemp "${TMPDIR:-/tmp}/dotfiles-update.XXXXXX")"
  "$@" 2>"${err}" || status=$?
  if (( status != 0 )); then
    cat "${err}" >&2
  fi
  rm -f "${err}"
  return "${status}"
}

require_tool() {
  local tool="$1"

  if ! command -v "${tool}" >/dev/null 2>&1; then
    log "${tool} is required to run this updater"
    exit 2
  fi
}

github_token() {
  if [[ -n "${GH_TOKEN:-}" ]]; then
    printf '%s' "${GH_TOKEN}"
  elif [[ -n "${GITHUB_TOKEN:-}" ]]; then
    printf '%s' "${GITHUB_TOKEN}"
  elif command -v gh >/dev/null 2>&1; then
    gh auth token 2>/dev/null || true
  fi
}

# The token reaches curl on stdin and Nix through the environment, never argv,
# where any local user could read it.
github_api() {
  local endpoint="$1"

  if [[ -n "${GITHUB_TOKEN_VALUE}" ]]; then
    curl -fsSL -H @- "https://api.github.com/${endpoint}" <<<"Authorization: Bearer ${GITHUB_TOKEN_VALUE}"
  else
    curl -fsSL "https://api.github.com/${endpoint}"
  fi
}

private_source() {
  local key="$1"
  local file="${DOTFILES_PRIVATE_SOURCES_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/dotfiles-private/sources.json}"

  if [[ ! -r "${file}" ]]; then
    log "Private source configuration is missing; see docs/rex.md"
    return 1
  fi
  jq -er --arg key "${key}" 'getpath($key | split(".")) | select(type == "string" and startswith("https://"))' "${file}"
}

latest_version() {
  local update_info="$1"
  local source

  source="$(jq -r '.source' <<<"${update_info}")"
  case "${source}" in
    sparkle)
      local url
      require_tool python3
      if jq -e '.privateUrlKey' <<<"${update_info}" >/dev/null; then
        url="$(private_source "$(jq -r '.privateUrlKey' <<<"${update_info}")")" || return 1
      else
        url="$(jq -r '.url' <<<"${update_info}")"
      fi
      curl -fsSL "${url}" | python3 -c '
import sys
import xml.etree.ElementTree as ET

item = ET.parse(sys.stdin).getroot().find("channel/item")
namespace = "{http://www.andymatuschak.org/xml-namespaces/sparkle}"
if item is None:
    sys.exit("No Sparkle releases found")
version = item.findtext(namespace + "shortVersionString")
build = item.findtext(namespace + "version")
if not version or not build:
    sys.exit("Sparkle release is missing its version or build")
print(version + "-" + build)
'
      ;;
    github-release)
      # Scan the release list rather than /releases/latest: a monorepo's latest
      # release may belong to another product (tagPrefix tells them apart), and
      # /releases/latest skips prereleases. Prerelease trains select a SemVer
      # channel; includePrereleases accepts releases upstream merely flags as
      # prereleases.
      local owner repo prefix channel prereleases pattern
      owner="$(jq -r '.owner' <<<"${update_info}")"
      repo="$(jq -r '.repo' <<<"${update_info}")"
      prefix="$(jq -r '.tagPrefix // ""' <<<"${update_info}")"
      channel="$(jq -r '.channel // ""' <<<"${update_info}")"
      prereleases="$(jq -r '.includePrereleases // false' <<<"${update_info}")"
      pattern=""
      if [[ -n "${channel}" ]]; then
        # The channel is interpolated into a regex below; keep it a SemVer
        # identifier.
        if [[ ! "${channel}" =~ ^[0-9A-Za-z][0-9A-Za-z-]*$ ]]; then
          log "${repo}: invalid prerelease channel '${channel}'"
          return 1
        fi
        # SemVer 2.0.0 prerelease tags are <version>-<identifier>[.<identifier>...]
        # and the channel must be the first identifier: 0.28.0-beta.1,
        # 0.0.46-nightly.20261015.3158, 1.0.0-rc.2.
        pattern="^[0-9]+\\.[0-9]+\\.[0-9]+-${channel}(\\.[0-9A-Za-z-]+)*$"
        prereleases=true
      fi
      github_api "repos/${owner}/${repo}/releases?per_page=100" \
        | jq -er --arg prefix "${prefix}" --arg pattern "${pattern}" --argjson prereleases "${prereleases}" '
            [
              .[]
              | select((.draft | not) and ($prereleases or (.prerelease | not)))
              | .tag_name
              | select(startswith($prefix))
              | .[($prefix | length):]
              | select($pattern == "" or test($pattern))
            ][0] // empty
          '
      ;;
    npm)
      local package channel
      package="$(jq -r '.package' <<<"${update_info}")"
      channel="$(jq -r '.channel // "latest"' <<<"${update_info}")"
      curl -fsSL "https://registry.npmjs.org/${package}" | jq -er --arg channel "${channel}" '."dist-tags"[$channel] // empty'
      ;;
    *)
      return 1
      ;;
  esac
}

release_asset_url() {
  local update_info="$1"
  local version="$2"
  local owner repo prefix pattern

  owner="$(jq -r '.owner' <<<"${update_info}")"
  repo="$(jq -r '.repo' <<<"${update_info}")"
  prefix="$(jq -r '.tagPrefix // ""' <<<"${update_info}")"
  pattern="$(jq -r '.assetPattern' <<<"${update_info}")"
  github_api "repos/${owner}/${repo}/releases/tags/${prefix}${version}" \
    | jq -er --arg pattern "${pattern}" \
      '[.assets[] | select(.name | test($pattern)) | .browser_download_url]
      | if length == 1 then .[0] else error("expected exactly one matching release asset") end'
}

package_systems() {
  local pkg="$1"
  local system

  for system in "${SYSTEMS[@]}"; do
    # Some systems take a package of the same name from a flake input, which
    # this updater does not own; only systems with update metadata are ours.
    if nix eval --raw ".#packages.${system}.${pkg}.updateInfo.source" >/dev/null 2>&1; then
      printf '%s\n' "${system}"
    fi
  done
}

# Rewrite the version and every per-platform hash in a package expression, then
# check the flake evaluates to them. URLs and current hashes come from the flake
# itself, so no URL scheme is duplicated here.
apply_update() {
  local pkg="$1"
  local file="$2"
  local current="$3"
  local latest="$4"
  local update_info="$5"
  shift 5
  local systems=("$@")
  local system oldurl newurl oldhash newhash content i
  local -a new_hashes=()

  content="$(<"${file}")"
  for system in "${systems[@]}"; do
    oldhash="$(quiet nix eval --raw ".#packages.${system}.${pkg}.src.outputHash")" || return 1
    if [[ "$(jq -r '.strategy // ""' <<<"${update_info}")" == require-file ]]; then
      newhash="$(cache_private_release "${update_info}" "${latest}")" || return 1
    else
      oldurl="$(quiet nix eval --raw ".#packages.${system}.${pkg}.src.url")" || return 1
      if jq -e '.assetPattern' <<<"${update_info}" >/dev/null; then
        newurl="$(release_asset_url "${update_info}" "${latest}")" || return 1
        content="${content//${oldurl##*/}/${newurl##*/}}"
      else
        newurl="${oldurl//${current}/${latest}}"
      fi
      newhash="$(quiet nix store prefetch-file --json "${newurl}" | jq -er '.hash')" || return 1
    fi
    content="${content//${oldhash}/${newhash}}"
    new_hashes+=("${newhash}")
  done
  content="${content//version = \"${current}\"/version = \"${latest}\"}"
  printf '%s\n' "${content}" >"${file}"

  if jq -e '.flakeInput' <<<"${update_info}" >/dev/null; then
    update_flake_input "${current}" "${latest}" "${update_info}" || return 1
  fi

  for i in "${!systems[@]}"; do
    if [[ "$(quiet nix eval --raw ".#packages.${systems[$i]}.${pkg}.version")" != "${latest}" \
      || "$(quiet nix eval --raw ".#packages.${systems[$i]}.${pkg}.src.outputHash")" != "${new_hashes[$i]}" ]]; then
      log "${pkg}: ${systems[$i]} does not evaluate to ${latest} after the rewrite"
      return 1
    fi
  done
}

# Bump a flake input pinned to the release tag that matches the package.
update_flake_input() {
  local current="$1"
  local latest="$2"
  local update_info="$3"
  local input owner repo prefix old_ref new_ref content

  input="$(jq -r '.flakeInput' <<<"${update_info}")"
  owner="$(jq -r '.owner' <<<"${update_info}")"
  repo="$(jq -r '.repo' <<<"${update_info}")"
  prefix="$(jq -r '.tagPrefix // ""' <<<"${update_info}")"
  old_ref="github:${owner}/${repo}/${prefix}${current}"
  new_ref="github:${owner}/${repo}/${prefix}${latest}"

  content="$(<"${BASEDIR}/flake.nix")"
  if [[ "${content}" != *"\"${old_ref}\""* ]]; then
    log "flake.nix does not pin ${input} to ${old_ref}"
    return 1
  fi
  printf '%s\n' "${content//\"${old_ref}\"/\"${new_ref}\"}" >"${BASEDIR}/flake.nix"
  quiet nix flake update "${input}"
}

cache_private_release() (
  local update_info="$1"
  local version="$2"
  local expected_hash="${3:-}"
  local url filename tempdir file hash

  url="$(private_source "$(jq -r '.privateUrlTemplateKey' <<<"${update_info}")")" || return 1
  url="${url//\{version\}/${version}}"
  filename="$(jq -r '.fileName' <<<"${update_info}")"
  filename="${filename//\{version\}/${version}}"
  tempdir="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-private-download.XXXXXX")" || return 1
  trap 'rm -rf "${tempdir}"' EXIT
  file="${tempdir}/${filename}"
  curl -fsSL "${url}" -o "${file}" || return 1
  hash="$(quiet nix hash file --type sha256 --sri "${file}")" || return 1
  if [[ -n "${expected_hash}" && "${hash}" != "${expected_hash}" ]]; then
    log "Private download does not match the pinned hash; refusing to import it"
    return 1
  fi
  quiet nix store add-file --name "${filename}" "${file}" >/dev/null || return 1
  printf '%s\n' "${hash}"
)

fetch_private_package() {
  local pkg="$1"
  local update_info version hash

  update_info="$(quiet nix eval --json ".#packages.${CURRENT_SYSTEM}.${pkg}.updateInfo")" || return 1
  if [[ "$(jq -r '.strategy' <<<"${update_info}")" != require-file ]]; then
    log "${pkg}: --fetch requires a private require-file package"
    return 1
  fi
  version="$(quiet nix eval --raw ".#packages.${CURRENT_SYSTEM}.${pkg}.version")" || return 1
  hash="$(quiet nix eval --raw ".#packages.${CURRENT_SYSTEM}.${pkg}.src.outputHash")" || return 1
  cache_private_release "${update_info}" "${version}" "${hash}" >/dev/null
}

# Print each root input whose locked revision differs between two lock files.
changed_inputs() {
  jq -nr --slurpfile old "$1" --slurpfile new "$2" '
    def revisions:
      .nodes as $nodes
      | $nodes.root.inputs
      | with_entries(.value = ($nodes[.value].locked
          | "\(.rev[0:7] // .narHash[7:19]) (\(.lastModified // 0 | todate[0:10]))"));
    ($old[0] | revisions) as $before
    | $new[0] | revisions | to_entries[]
    | select($before[.key] != .value)
    | "\(.key) \($before[.key] // "none") -> \(.value)"
  '
}

skill_version() {
  local name

  name="$(quiet nix eval --raw ".#checks.${CURRENT_SYSTEM}.$1.generated.name")" || return 1
  name="${name#*-skill-}"
  printf '%s\n' "${name%.md}"
}

regenerate_skill() {
  local check="$1"
  local before="$2"
  local skill="agents/skills/generated/${3}/SKILL.md"
  local generated after

  program_status working "Regenerating ${skill}"
  if generated="$(quiet nix build --no-link --print-out-paths ".#checks.${CURRENT_SYSTEM}.${check}.generated")" \
    && after="$(skill_version "${check}")"; then
    if ! cmp -s "${generated}" "${skill}"; then
      cp "${generated}" "${skill}"
      chmod 644 "${skill}"
      changed "${skill} ${before} -> ${after}"
    fi
  else
    failed "${skill}" "could not build it"
  fi
}

# Update every input, then the files generated from tools the inputs provide.
update_inputs() {
  local lock_before entry line
  local -a skill_versions=()

  for entry in "${SKILLS[@]}"; do
    skill_versions+=("$(skill_version "${entry%%:*}" || echo unknown)")
  done

  log "Updating flake inputs"
  program_status working "Updating flake inputs"
  lock_before="$(mktemp "${TMPDIR:-/tmp}/dotfiles-update-lock.XXXXXX")"
  cp flake.lock "${lock_before}"
  if quiet nix flake update; then
    while IFS= read -r line; do
      changed "${line}"
    done < <(changed_inputs "${lock_before}" flake.lock)
  else
    failed "flake inputs" "nix flake update failed"
  fi
  rm -f "${lock_before}"

  for entry in "${!SKILLS[@]}"; do
    regenerate_skill "${SKILLS[${entry}]%%:*}" "${skill_versions[${entry}]}" "${SKILLS[${entry}]#*:}"
  done
}

update_package() {
  local file="$1"
  local pkg current latest update_info backup
  local -a systems

  pkg="$(sed -n 's/.*pname = "\([^"]*\)".*/\1/p' "${file}" | head -n1)"
  [[ -n "${pkg}" ]] || return 0
  mapfile -t systems < <(package_systems "${pkg}")
  if (( ${#systems[@]} == 0 )); then
    log "${pkg}: no flake package with update metadata; skipping"
    return 0
  fi

  if ! current="$(quiet nix eval --raw ".#packages.${systems[0]}.${pkg}.version")" \
    || ! update_info="$(quiet nix eval --json ".#packages.${systems[0]}.${pkg}.updateInfo")"; then
    failed "${pkg}" "could not evaluate its version and update metadata"
    return 0
  fi
  if jq -e '.privateUrlKey' <<<"${update_info}" >/dev/null \
    && ! private_source "$(jq -r '.privateUrlKey' <<<"${update_info}")" >/dev/null 2>&1; then
    log "${pkg}: private source configuration unavailable; see docs/rex.md; skipping"
    return 0
  fi
  if ! latest="$(latest_version "${update_info}")"; then
    failed "${pkg}" "could not discover the latest upstream version"
    return 0
  fi
  if [[ "${current}" == "${latest}" ]]; then
    log "${pkg}: up to date (${current})"
    return 0
  fi
  if [[ "${APPLY}" != true ]]; then
    log "${pkg}: update available (${current} -> ${latest})"
    changed "${pkg} ${current} -> ${latest}"
    return 0
  fi

  log "${pkg}: updating ${current} -> ${latest}"
  program_status working "Updating ${pkg} to ${latest}"
  backup="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-update-backup.XXXXXX")"
  cp "${file}" flake.nix flake.lock "${backup}/"
  if apply_update "${pkg}" "${file}" "${current}" "${latest}" "${update_info}" "${systems[@]}"; then
    changed "${pkg} ${current} -> ${latest}"
  else
    cp "${backup}/${file##*/}" "${file}"
    cp "${backup}/flake.nix" "${backup}/flake.lock" .
    failed "${pkg}" "could not update to ${latest}; left at ${current}"
  fi
  rm -rf "${backup}"
}

update_packages() {
  local -a files=("${BASEDIR}"/nix/packages/*.nix)
  local index

  mapfile -t SYSTEMS < <(quiet nix eval --json ".#packages" --apply builtins.attrNames | jq -r '.[]')
  for index in "${!files[@]}"; do
    program_status working "Checking packages" "progress=$(( index * 100 / ${#files[@]} ))"
    update_package "${files[$index]}"
  done
}

skopeo() {
  "${SKOPEO}" "$@"
}

# The digest a registry reports for a reference is the sha256 of its raw
# manifest (the multi-platform index when there is one).
image_digest() {
  printf 'sha256:%s\n' "$(skopeo inspect --raw "docker://$1" | sha256sum | cut -d' ' -f1)"
}

tag_shape() {
  sed -E 's/[.]/\\./g; s/[0-9]+/[0-9]+/g' <<<"$1"
}

# Below 1.0 a release that changes the second number is the one that may
# break, so 0.5 and 0.6 are different majors while 1.5 and 1.6 are not.
tag_major() {
  [[ "$1" =~ ^v?([0-9]+)(\.([0-9]+))? ]] || return 1
  if (( 10#${BASH_REMATCH[1]} == 0 )); then
    printf '0.%s\n' "$(( 10#${BASH_REMATCH[3]:-0} ))"
  else
    printf '%s\n' "$(( 10#${BASH_REMATCH[1]} ))"
  fi
}

# Print the newest tag shaped like the given one, compared as versions, or
# print why there is no unambiguous newest tag and fail. With a third argument,
# consider only tags of that major.
newest_tag() {
  local repository="$1"
  local tag="$2"
  local major="${3:-}"
  local release="${tag%%-*}"
  local shape newest second current_major newest_major
  local -a candidates

  shape="$(tag_shape "${tag}")"
  # A pre-release may move on to its release; any other suffix, such as
  # -alpine, names a variant the image must keep.
  if [[ "${tag}" == *-* && "${tag#*-}" =~ ^(alpha|beta|rc|pre|preview|dev|nightly) ]]; then
    shape="$(tag_shape "${release}")(-$(tag_shape "${tag#*-}"))?"
  fi
  # A suffix sorts after its release under sort -V; as ~ it sorts before it.
  mapfile -t candidates < <(
    skopeo list-tags "docker://${repository}" \
      | jq -r '.Tags[]' \
      | grep -E "^${shape}$" \
      | sed 's/-/~/' | sort -V | sed 's/~/-/' \
      | while read -r candidate; do
          if [[ -z "${major}" || "$(tag_major "${candidate}")" == "${major}" ]]; then
            printf '%s\n' "${candidate}"
          fi
        done
  )
  if (( ${#candidates[@]} == 0 )); then
    echo "no tags shaped like ${tag}"
    return 1
  fi
  newest="${candidates[-1]}"
  second=""
  if (( ${#candidates[@]} > 1 )); then
    second="${candidates[-2]}"
  fi
  if [[ -n "${second}" && "$(sed -E 's/(^|[^0-9])0+([0-9])/\1\2/g' <<<"${newest}")" == "$(sed -E 's/(^|[^0-9])0+([0-9])/\1\2/g' <<<"${second}")" ]]; then
    echo "${newest} and ${second} are the same version"
    return 1
  fi
  current_major="$(grep -oE '[0-9]+' <<<"${tag}" | head -n1)"
  newest_major="$(grep -oE '[0-9]+' <<<"${newest}" | head -n1)"
  # A different number of digits usually means another numbering scheme, such
  # as dates, sharing the shape.
  if (( ${#current_major} != ${#newest_major} )); then
    echo "newest tag ${newest} may follow another numbering scheme"
    return 1
  fi
  if [[ "$(printf '%s\n' "${tag}" "${newest}" | sed 's/-/~/' | sort -V | tail -n1 | sed 's/~/-/')" != "${newest}" ]]; then
    echo "newest tag ${newest} is older than ${tag}"
    return 1
  fi
  printf '%s\n' "${newest}"
}

# Move an image to the newest tag of the same shape (or, for tags that are not
# versions, such as latest, to the tag's current digest) and rewrite its one
# occurrence under nix/hosts.
update_image() {
  local reference="$1"
  local name="${reference%@*}"
  local digest="${reference#*@}"
  local repository="${name%:*}"
  local tag="${name##*:}"
  local new_tag="${tag}"
  local new_digest new_reference file content reason

  if [[ "$(grep -rhoF --include='*.nix' "\"${reference}\"" nix/hosts | wc -l)" != 1 ]]; then
    failed "${repository}" "${reference} appears more than once under nix/hosts"
    return 0
  fi
  if [[ "${tag}" =~ ^v?[0-9]+(\.[0-9]+)*(-[0-9A-Za-z.]+)?$ ]]; then
    if reason="$(newest_tag "${repository}" "${tag}")"; then
      new_tag="${reason}"
      # A major usually migrates the application's data one way, so an
      # unattended run stays within the current one.
      if [[ "$(tag_major "${new_tag}")" != "$(tag_major "${tag}")" ]]; then
        if [[ "${MAJORS}" == true ]]; then
          note "${repository}: ${tag} -> ${new_tag} is a new major version"
        else
          note "${repository}: ${tag} -> ${new_tag} is a new major version, held; take it with ./update --apply --majors"
          new_tag="$(newest_tag "${repository}" "${tag}" "$(tag_major "${tag}")")" || new_tag="${tag}"
        fi
      fi
    else
      note "${repository}: ${reason}; refreshed the digest of ${tag} only"
    fi
  fi
  if ! new_digest="$(image_digest "${repository}:${new_tag}")" \
    || ! skopeo inspect --raw "docker://${repository}@${new_digest}" >/dev/null; then
    failed "${repository}" "could not resolve ${new_tag}"
    return 0
  fi
  new_reference="${repository}:${new_tag}@${new_digest}"
  if [[ "${new_reference}" == "${reference}" ]]; then
    log "${repository}: up to date (${tag})"
    return 0
  fi

  if [[ "${APPLY}" == true ]]; then
    file="$(grep -rlF --include='*.nix' "\"${reference}\"" nix/hosts)"
    content="$(<"${file}")"
    printf '%s\n' "${content//\"${reference}\"/\"${new_reference}\"}" >"${file}"
  fi
  changed "${repository} ${tag}@${digest:0:19} -> ${new_tag}@${new_digest:0:19}"
}

update_images() {
  local reference
  local -a references

  mapfile -t references < <(grep -rhoE --include='*.nix' '"[^" ]+:[^" @]+@sha256:[0-9a-f]{64}"' nix/hosts 2>/dev/null | tr -d '"' | sort -u)
  (( ${#references[@]} > 0 )) || return 0
  # Reached through the flake's nixpkgs so the updater needs no container tools.
  if ! SKOPEO="$(quiet nix build --no-link --print-out-paths --inputs-from . 'nixpkgs#skopeo^out')/bin/skopeo"; then
    failed "images" "could not build skopeo"
    return 0
  fi
  for reference in "${references[@]}"; do
    program_status working "Checking ${reference%%:*}"
    update_image "${reference}"
  done
}

usage() {
  cat <<EOF
Update flake inputs, generated skill files, manually packaged binaries and
pinned container images.

Usage: ./update [--apply [--majors] | --fetch PACKAGE]

  (none)    Report the package and image updates available; change nothing.
  --apply   Update every flake input, regenerate the skill files and bump
            every out-of-date package and image. Never prompts. Prints one
            line per change on stdout (name old -> new), then "note:" lines,
            and exits 1 if anything failed; the updates that succeeded stay
            in the tree.
  --majors  Also move images to a new major version. Without it, an image
            stays within its major (below 1.0, the second number) and a
            "note:" line names the newer major.
  --fetch PACKAGE
            Cache a pinned private download without updating any files or inputs.
  -h, --help

The GitHub token comes from GH_TOKEN, GITHUB_TOKEN or \`gh auth token\`.
EOF
}

main() {
  local fetch_package=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply)
        APPLY=true
        shift
        ;;
      --majors)
        MAJORS=true
        shift
        ;;
      --fetch)
        if [[ $# -lt 2 || "$2" == -* ]]; then
          log "--fetch requires a package name"
          exit 2
        fi
        fetch_package="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        log "Unknown option: $1"
        usage >&2
        exit 2
        ;;
    esac
  done

  if [[ "${APPLY}" == true && -n "${fetch_package}" ]]; then
    log "Use --apply or --fetch, not both"
    exit 2
  fi

  require_tool nix
  require_tool curl
  require_tool jq
  CURRENT_SYSTEM="$(nix eval --impure --raw --expr builtins.currentSystem)"
  GITHUB_TOKEN_VALUE="$(github_token)"
  if [[ -n "${GITHUB_TOKEN_VALUE}" ]]; then
    export NIX_CONFIG="${NIX_CONFIG:+${NIX_CONFIG}$'\n'}access-tokens = github.com=${GITHUB_TOKEN_VALUE}"
  fi

  cd "${BASEDIR}"
  trap report_exit_status EXIT

  if [[ -n "${fetch_package}" ]]; then
    program_status working "Caching ${fetch_package}"
    fetch_private_package "${fetch_package}"
    exit 0
  fi

  if [[ "${APPLY}" == true ]]; then
    update_inputs
  fi
  update_packages
  update_images

  if (( ${#CHANGES[@]} > 0 )); then
    printf '%s\n' "${CHANGES[@]}"
  fi
  if (( ${#NOTES[@]} > 0 )); then
    printf 'note: %s\n' "${NOTES[@]}"
  fi
  if (( ${#CHANGES[@]} == 0 )); then
    log "Everything is up to date"
  fi
  if [[ "${APPLY}" != true && ${#CHANGES[@]} -gt 0 ]]; then
    log "Re-run with --apply to update"
  fi
  if (( ${#FAILURES[@]} > 0 )); then
    log "Failed: ${FAILURES[*]}"
    exit 1
  fi
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
