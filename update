#!/usr/bin/env bash

set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NIX_ACCESS_TOKEN_ARGS=()

# A run detached into its own session has no controlling terminal, so the
# caller names the terminal that should receive OSC 7501 reports.
STATUS_TTY="${DOTFILES_STATUS_TTY:-/dev/tty}"

if command -v gh >/dev/null 2>&1; then
  github_token="$(gh auth token 2>/dev/null || true)"
  if [[ -n "${github_token}" ]]; then
    NIX_ACCESS_TOKEN_ARGS=(--option access-tokens "github.com=${github_token}")
  fi
fi

APPLY=false

has_gum() {
  command -v gum >/dev/null 2>&1
}

log_message() {
  local level="$1"
  shift

  if has_gum; then
    gum log --level "${level}" "$*"
  else
    case "${level}" in
      error|warn)
        printf '%s\n' "$*" >&2
        ;;
      *)
        printf '%s\n' "$*"
        ;;
    esac
  fi
}

section() {
  local title="$1"

  if has_gum; then
    gum style --bold --foreground 255 --background 62 --padding "0 1" --margin "1 0" "${title}"
  else
    printf '\n== %s ==\n' "${title}"
  fi
}

show_log() {
  local logfile="$1"

  if [[ -s "${logfile}" ]]; then
    printf '\n' >&2
    cat "${logfile}" >&2
  fi
}

# Report state to the terminal with OSC 7501:
# https://www.superlogical.com/rex/docs/build/program-status
program_status() {
  local state="$1"
  local message="$2"
  shift 2
  local pairs=("state=${state}" app=dotfiles "$@" "msg=$(printf '%s' "${message}" | base64 | tr -d '\n')")
  local IFS=:

  { printf '\e]7501;%s\e\\' "${pairs[*]}" >"${STATUS_TTY}"; } 2>/dev/null || true
}

report_exit_status() {
  local status=$?

  case "${status}" in
    0) program_status "done" "Dotfiles update complete" ;;
    130) program_status idle "Dotfiles update cancelled" ;;
    *) program_status error "Dotfiles update failed" ;;
  esac
}

run_quiet_step() {
  local title="$1"
  shift

  local logfile
  local pid
  local status=0

  program_status working "${title}"
  logfile="$(mktemp "${TMPDIR:-/tmp}/dotfiles-update.XXXXXX")"
  "$@" >"${logfile}" 2>&1 &
  pid=$!

  if has_gum; then
    gum spin --spinner dot --title "${title}" -- bash -c 'pid="$1"; while kill -0 "$pid" 2>/dev/null; do sleep 0.1; done' _ "${pid}"
  else
    log_message info "${title}"
  fi

  if wait "${pid}"; then
    status=0
  else
    status=$?
  fi

  if (( status == 0 )); then
    rm -f "${logfile}"
    log_message info "${title} complete"
    return 0
  fi

  log_message error "${title} failed"
  show_log "${logfile}"
  rm -f "${logfile}"
  return "${status}"
}

warn_if_git_dirty() {
  if command -v git >/dev/null 2>&1 && [[ -n "$(git -C "${BASEDIR}" status --short 2>/dev/null)" ]]; then
    log_message warn "Git tree is dirty; Nix may warn during evaluation"
  fi
}

confirm_apply() {
  local count="$1"

  if [[ "${APPLY}" == true ]]; then
    return 0
  fi

  if has_gum && [[ -t 0 ]]; then
    program_status blocked "Apply ${count} package update(s)?" kind=permission
    if gum confirm "Apply ${count} package update(s)?"; then
      return 0
    fi
    return 1
  fi

  log_message info "Re-run with --apply to bump versions and hashes"
  return 1
}

require_tool() {
  local tool="$1"

  if ! command -v "${tool}" >/dev/null 2>&1; then
    log_message error "${tool} is required to run this updater"
    exit 1
  fi
}

github_api() {
  local endpoint="$1"

  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    gh api "${endpoint}"
  else
    curl -fsSL "https://api.github.com/${endpoint}"
  fi
}

private_source() {
  local key="$1"
  local file="${DOTFILES_PRIVATE_SOURCES_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/dotfiles-private/sources.json}"

  if [[ ! -r "${file}" ]]; then
    log_message error "Private source configuration is missing; see docs/rex.md"
    return 1
  fi
  jq -er --arg key "${key}" 'getpath($key | split(".")) | select(type == "string" and startswith("https://"))' "${file}"
}

latest_update() {
  local update_info="$1"
  local source

  source="$(jq -r '.source' <<<"${update_info}")"
  case "${source}" in
    sparkle)
      local url
      require_tool python3
      if jq -e '.privateUrlKey' <<<"${update_info}" >/dev/null; then
        url="$(private_source "$(jq -r '.privateUrlKey' <<<"${update_info}")")" || return 1
      else
        url="$(jq -r '.url' <<<"${update_info}")"
      fi
      curl -fsSL "${url}" | python3 -c '
import sys
import xml.etree.ElementTree as ET

item = ET.parse(sys.stdin).getroot().find("channel/item")
namespace = "{http://www.andymatuschak.org/xml-namespaces/sparkle}"
if item is None:
    sys.exit("No Sparkle releases found")
version = item.findtext(namespace + "shortVersionString")
build = item.findtext(namespace + "version")
if not version or not build:
    sys.exit("Sparkle release is missing its version or build")
print(version + "-" + build)
'
      ;;
    github-release)
      # Scan the release list rather than /releases/latest: a monorepo's latest
      # release may belong to another product (tagPrefix tells them apart), and
      # /releases/latest skips prereleases. Prerelease trains select a SemVer
      # channel; includePrereleases accepts releases upstream merely flags as
      # prereleases.
      local owner repo prefix channel prereleases pattern
      owner="$(jq -r '.owner' <<<"${update_info}")"
      repo="$(jq -r '.repo' <<<"${update_info}")"
      prefix="$(jq -r '.tagPrefix // ""' <<<"${update_info}")"
      channel="$(jq -r '.channel // ""' <<<"${update_info}")"
      prereleases="$(jq -r '.includePrereleases // false' <<<"${update_info}")"
      pattern=""
      if [[ -n "${channel}" ]]; then
        # The channel is interpolated into a regex below; keep it a SemVer
        # identifier.
        if [[ ! "${channel}" =~ ^[0-9A-Za-z][0-9A-Za-z-]*$ ]]; then
          log_message error "${repo}: invalid prerelease channel '${channel}'"
          return 1
        fi
        # SemVer 2.0.0 prerelease tags are <version>-<identifier>[.<identifier>...]
        # and the channel must be the first identifier: 0.28.0-beta.1,
        # 0.0.46-nightly.20261015.3158, 1.0.0-rc.2.
        pattern="^[0-9]+\\.[0-9]+\\.[0-9]+-${channel}(\\.[0-9A-Za-z-]+)*$"
        prereleases=true
      fi
      github_api "repos/${owner}/${repo}/releases?per_page=100" \
        | jq -er --arg prefix "${prefix}" --arg pattern "${pattern}" --argjson prereleases "${prereleases}" '
              [
                .[]
                | select((.draft | not) and ($prereleases or (.prerelease | not)))
                | .tag_name
                | select(startswith($prefix))
                | .[($prefix | length):]
                | select($pattern == "" or test($pattern))
              ][0] // empty
            '
      ;;
    npm)
      local package channel
      package="$(jq -r '.package' <<<"${update_info}")"
      channel="$(jq -r '.channel // "latest"' <<<"${update_info}")"
      curl -fsSL "https://registry.npmjs.org/${package}" | jq -er --arg channel "${channel}" '."dist-tags"[$channel] // empty'
      ;;
    *)
      return 1
      ;;
  esac
}

release_asset_url() {
  local update_info="$1"
  local version="$2"
  local owner repo prefix pattern

  owner="$(jq -r '.owner' <<<"${update_info}")"
  repo="$(jq -r '.repo' <<<"${update_info}")"
  prefix="$(jq -r '.tagPrefix // ""' <<<"${update_info}")"
  pattern="$(jq -r '.assetPattern' <<<"${update_info}")"
  github_api "repos/${owner}/${repo}/releases/tags/${prefix}${version}" \
    | jq -er --arg pattern "${pattern}" \
      '[.assets[] | select(.name | test($pattern)) | .browser_download_url]
      | if length == 1 then .[0] else error("expected exactly one matching release asset") end'
}

package_systems() {
  local pkg="$1"
  local system

  for system in "${SYSTEMS[@]}"; do
    # Some systems take a package of the same name from a flake input, which
    # this updater does not own; only systems with update metadata are ours.
    if nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.updateInfo.source" >/dev/null 2>&1; then
      printf '%s\n' "${system}"
    fi
  done
}

# Rewrite version and every per-platform hash in a package expression. URLs and
# current hashes come from the flake itself, so no URL scheme is duplicated here.
apply_update() {
  local pkg="$1"
  local file="$2"
  local current="$3"
  local latest="$4"
  local update_info="$5"

  local system oldurl oldhash newurl newhash content i old_asset new_asset
  local -a pkg_systems=()
  local -a old_hashes=()
  local -a new_hashes=()

  mapfile -t pkg_systems < <(package_systems "${pkg}")
  if (( ${#pkg_systems[@]} == 0 )); then
    return 1
  fi

  if jq -e '.assetPattern' <<<"${update_info}" >/dev/null; then
    newurl="$(release_asset_url "${update_info}" "${latest}")" || return 1
  fi

  for system in "${pkg_systems[@]}"; do
    oldurl="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.src.url")"
    oldhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.src.outputHash")"
    if ! jq -e '.assetPattern' <<<"${update_info}" >/dev/null; then
      newurl="${oldurl//${current}/${latest}}"
    fi
    newhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" store prefetch-file --json "${newurl}" | jq -r '.hash')" || return 1
    old_hashes+=("${oldhash}")
    new_hashes+=("${newhash}")
  done

  content="$(cat "${file}")"
  for i in "${!old_hashes[@]}"; do
    content="${content//${old_hashes[$i]}/${new_hashes[$i]}}"
  done
  if jq -e '.assetPattern' <<<"${update_info}" >/dev/null; then
    old_asset="${oldurl##*/}"
    new_asset="${newurl##*/}"
    content="${content//${old_asset}/${new_asset}}"
  fi
  content="${content//version = \"${current}\"/version = \"${latest}\"}"
  printf '%s\n' "${content}" >"${file}"

  if jq -e '.flakeInput' <<<"${update_info}" >/dev/null; then
    update_flake_input "${current}" "${latest}" "${update_info}" || return 1
  fi
}

# Bump a flake input pinned to the release tag that matches the package.
update_flake_input() {
  local current="$1"
  local latest="$2"
  local update_info="$3"
  local input owner repo prefix old_ref new_ref content

  input="$(jq -r '.flakeInput' <<<"${update_info}")"
  owner="$(jq -r '.owner' <<<"${update_info}")"
  repo="$(jq -r '.repo' <<<"${update_info}")"
  prefix="$(jq -r '.tagPrefix // ""' <<<"${update_info}")"
  old_ref="github:${owner}/${repo}/${prefix}${current}"
  new_ref="github:${owner}/${repo}/${prefix}${latest}"

  content="$(cat "${BASEDIR}/flake.nix")"
  if [[ "${content}" != *"\"${old_ref}\""* ]]; then
    log_message error "flake.nix does not pin ${input} to ${old_ref}"
    return 1
  fi
  printf '%s\n' "${content//\"${old_ref}\"/\"${new_ref}\"}" >"${BASEDIR}/flake.nix"
  nix "${NIX_ACCESS_TOKEN_ARGS[@]}" flake update "${input}"
}

cache_private_release() (
  local update_info="$1"
  local version="$2"
  local expected_hash="${3:-}"
  local url filename tempdir file hash

  url="$(private_source "$(jq -r '.privateUrlTemplateKey' <<<"${update_info}")")" || return 1
  url="${url//\{version\}/${version}}"
  filename="$(jq -r '.fileName' <<<"${update_info}")"
  filename="${filename//\{version\}/${version}}"
  tempdir="$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-private-download.XXXXXX")" || return 1
  trap 'rm -rf "${tempdir}"' EXIT
  file="${tempdir}/${filename}"
  curl -fsSL "${url}" -o "${file}" || return 1
  hash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" hash file --type sha256 --sri "${file}")" || return 1
  if [[ -n "${expected_hash}" && "${hash}" != "${expected_hash}" ]]; then
    log_message error "Private download does not match the pinned hash; refusing to import it"
    return 1
  fi
  nix "${NIX_ACCESS_TOKEN_ARGS[@]}" store add-file --name "${filename}" "${file}" >/dev/null || return 1
  printf '%s\n' "${hash}"
)

apply_private_update() {
  local pkg="$1"
  local file="$2"
  local current="$3"
  local latest="$4"
  local system="$5"
  local update_info="$6"
  local oldhash newhash content

  oldhash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${system}.${pkg}.src.outputHash")" || return 1
  newhash="$(cache_private_release "${update_info}" "${latest}")" || return 1
  content="$(cat "${file}")"
  content="${content//${oldhash}/${newhash}}"
  content="${content//version = \"${current}\"/version = \"${latest}\"}"
  printf '%s\n' "${content}" >"${file}"
}

fetch_private_package() {
  local pkg="$1"
  local update_info version hash

  update_info="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --json ".#packages.${CURRENT_SYSTEM}.${pkg}.updateInfo")" || return 1
  if [[ "$(jq -r '.strategy' <<<"${update_info}")" != require-file ]]; then
    log_message error "${pkg}: --fetch requires a private require-file package"
    return 1
  fi
  version="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${CURRENT_SYSTEM}.${pkg}.version")" || return 1
  hash="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${CURRENT_SYSTEM}.${pkg}.src.outputHash")" || return 1
  cache_private_release "${update_info}" "${version}" "${hash}" >/dev/null
}

regenerate_skill() {
  local package="$1"
  local name="$2"
  local generated
  local generated_source
  local skill="${BASEDIR}/agents/skills/generated/${name}/SKILL.md"

  generated="$(mktemp "${skill}.XXXXXX")"
  if generated_source="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" build --no-link --print-out-paths ".#${package}")" \
    && cp "${generated_source}" "${generated}"; then
    mv "${generated}" "${skill}"
  else
    rm -f "${generated}"
    return 1
  fi
}

usage() {
  cat <<EOF
Update flake inputs and manually packaged binaries.

Usage: ./update [--apply | --fetch PACKAGE]

  --apply   Bump version and hashes for any out-of-date package.
  --fetch PACKAGE
            Cache a pinned private download without updating any files or inputs.
  -h, --help
EOF
}

FETCH_PACKAGE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply)
      APPLY=true
      shift
      ;;
    --fetch)
      if [[ $# -lt 2 || "$2" == -* ]]; then
        log_message error "--fetch requires a package name"
        exit 1
      fi
      FETCH_PACKAGE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      log_message error "Unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

if [[ "${APPLY}" == true && -n "${FETCH_PACKAGE}" ]]; then
  log_message error "Use --apply or --fetch, not both"
  exit 1
fi

require_tool nix
require_tool curl
require_tool jq
CURRENT_SYSTEM="$(nix eval --impure --raw --expr builtins.currentSystem)"

cd "${BASEDIR}"
trap report_exit_status EXIT
section "Dotfiles update"
warn_if_git_dirty

if [[ -n "${FETCH_PACKAGE}" ]]; then
  run_quiet_step "Caching ${FETCH_PACKAGE}" fetch_private_package "${FETCH_PACKAGE}"
  exit 0
fi

if [[ "${APPLY}" == true ]]; then
  section "Update flake inputs"
  run_quiet_step "Updating flake inputs" nix "${NIX_ACCESS_TOKEN_ARGS[@]}" flake update

  section "Update generated files"
  run_quiet_step "Updating Browser skill" regenerate_skill agent-browser-skill agent-browser
  run_quiet_step "Updating Herdr skill" regenerate_skill herdr-skill herdr
  run_quiet_step "Updating Hunk skill" regenerate_skill hunk-skill hunk-review
fi

section "Check packaged binaries"

mapfile -t SYSTEMS < <(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --json ".#packages" --apply builtins.attrNames | jq -r '.[]')

updates=()
package_files=("${BASEDIR}"/nix/packages/*.nix)
for index in "${!package_files[@]}"; do
  file="${package_files[$index]}"
  pkg="$(sed -n 's/.*pname = "\([^"]*\)".*/\1/p' "${file}" | head -n1)"
  [[ -n "${pkg}" ]] || continue
  program_status working "Checking ${pkg}" "progress=$(( index * 100 / ${#package_files[@]} ))"

  mapfile -t supported_systems < <(package_systems "${pkg}")
  package_system="${supported_systems[0]:-}"
  if [[ -z "${package_system}" ]]; then
    log_message warn "${pkg}: no flake package with update metadata; skipping"
    continue
  fi

  current_version="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --raw ".#packages.${package_system}.${pkg}.version" 2>/dev/null || true)"
  if [[ -z "${current_version}" ]]; then
    log_message warn "${pkg}: no version attribute; skipping"
    continue
  fi

  update_info="$(nix "${NIX_ACCESS_TOKEN_ARGS[@]}" eval --json ".#packages.${package_system}.${pkg}.updateInfo" 2>/dev/null || true)"
  if [[ -z "${update_info}" || "${update_info}" == null ]]; then
    log_message warn "${pkg}: no update metadata; skipping"
    continue
  fi

  if jq -e '.privateUrlKey' <<<"${update_info}" >/dev/null \
    && ! private_source "$(jq -r '.privateUrlKey' <<<"${update_info}")" >/dev/null 2>&1; then
    log_message warn "${pkg}: private source configuration unavailable; see docs/rex.md; skipping"
    continue
  fi
  latest_version="$(latest_update "${update_info}" 2>/dev/null || true)"
  if [[ -z "${latest_version}" ]]; then
    log_message warn "${pkg}: failed to discover latest upstream version; skipping"
    continue
  fi

  if [[ "${current_version}" == "${latest_version}" ]]; then
    log_message info "${pkg}: up to date (${current_version})"
  else
    log_message warn "${pkg}: update available (${current_version} -> ${latest_version})"
    encoded_update_info="$(printf '%s' "${update_info}" | base64 --wrap=0)"
    updates+=("${pkg}|${file}|${current_version}|${latest_version}|${package_system}|${encoded_update_info}")
  fi
done

if (( ${#updates[@]} == 0 )); then
  log_message info "All packaged binaries up to date"
  exit 0
fi

if ! confirm_apply "${#updates[@]}"; then
  exit 0
fi

section "Apply updates"
for entry in "${updates[@]}"; do
  IFS='|' read -r pkg file current_version latest_version package_system encoded_update_info <<<"${entry}"
  update_info="$(printf '%s' "${encoded_update_info}" | base64 --decode)"
  strategy="$(jq -r '.strategy // "archive"' <<<"${update_info}")"
  case "${strategy}" in
    require-file)
      update_command=(apply_private_update "${pkg}" "${file}" "${current_version}" "${latest_version}" "${package_system}" "${update_info}")
      ;;
    archive)
      update_command=(apply_update "${pkg}" "${file}" "${current_version}" "${latest_version}" "${update_info}")
      ;;
    *)
      log_message error "${pkg}: unknown update strategy ${strategy}"
      continue
      ;;
  esac
  if ! run_quiet_step "Bumping ${pkg} to ${latest_version}" "${update_command[@]}"; then
    log_message error "${pkg}: failed to bump; left unchanged"
  fi
done

log_message info "Run ./check to validate, then ./install to switch"
