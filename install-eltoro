#!/usr/bin/env bash
# Build el toro on this machine and activate it on the container.
set -euo pipefail

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_HOST="${ELTORO_HOST:-root@eltoro}"
NIX_ACCESS_TOKEN_ARGS=()

if command -v gh >/dev/null 2>&1; then
  github_token="$(gh auth token 2>/dev/null || true)"
  if [[ -n "${github_token}" ]]; then
    NIX_ACCESS_TOKEN_ARGS=(--option access-tokens "github.com=${github_token}")
  fi
fi

if ! command -v nixos-rebuild >/dev/null 2>&1; then
  printf 'nixos-rebuild is required to deploy el toro.\n' >&2
  exit 1
fi

# Default to switching unless an explicit nixos-rebuild action is given.
if ! printf '%s\n' "$@" |
  grep -qx -E '^(switch|boot|test|build|edit|repl|dry-build|dry-run|dry-activate|build-image|build-vm|build-vm-with-bootloader|list-generations)$'; then
  set -- "$@" switch
fi

exec nixos-rebuild \
  "${NIX_ACCESS_TOKEN_ARGS[@]}" \
  --flake "${BASEDIR}#eltoro" \
  --target-host "${TARGET_HOST}" \
  "$@"
