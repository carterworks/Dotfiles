{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "worktree": {
    "directory": "{env:CODEHOME}/worktrees"
  },
  "websearch": {
    "provider": "exa"
  },
  "disabled_providers": [],
  "mcp": {
    "servers": {
      "cua-driver": {
        "type": "local",
        "command": [
          "/bin/sh",
          "-c",
          "exec cua-driver mcp --socket \"${XDG_CACHE_HOME:-$HOME/.cache}/cua-driver/cua-driver.sock\""
        ],
        "disabled": false
      },
      "fff": {
        "type": "local",
        "command": ["fff-mcp"],
        "disabled": false
      }
    }
  },
  "plugins": [
    {
      "package": "./cache-compaction",
      "options": {
        "ttl": "5m",
        "marginMs": 60000,
        "minInputTokens": 32000
      }
    }
  ]
}
