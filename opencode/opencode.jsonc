{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "worktree": {
    "directory": "{env:CODEHOME}/worktrees"
  },
  "websearch": {
    "provider": "exa"
  },
  "disabled_providers": [],
  "plugins": [
    "./complaints-box"
  ],
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": ["browse", "mcp"],
        "disabled": false
      },
      "fff": {
        "type": "local",
        "command": ["fff-mcp"],
        "disabled": false
      }
    }
  }
}
